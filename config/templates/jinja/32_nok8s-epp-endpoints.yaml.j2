{% if nok8s.enabled %}
{# ============================================================================
   nok8s EPP endpoints file (file-discovery plugin input).
   One entry per engine worker; worker i is published on hostPort + i.
   Addresses must be literal IPv4 (the plugin does not resolve hostnames).
   With watchFile: true the EPP reloads this on atomic rewrite.
   ============================================================================ #}
endpoints:
{% for i in range(nok8s.engine.replicas) %}
  - name: modelserver-{{ i }}
    address: 127.0.0.1
    port: "{{ nok8s.engine.hostPort + i }}"
    labels:
      model: {{ model.name }}
{% endfor %}
{% endif %}
