{% if standalone.enabled %}

{# ============================================================================
   standalone-deployment.yaml.j2

   Standalone vLLM deployment without llm-d routing infrastructure.
   Useful for simple single-model deployments or testing.

   Volume handling:
     Uses engine.volumes/volumeMounts as the dynamic base (shared with
     modelservice), plus a conditional model-cache PVC and any additional
     volumes defined in standalone.additionalVolumes/additionalVolumeMounts.
     This matches the original bash behavior where ALL volumes are injected
     dynamically — no hard-coded volumes.

   Launcher container:
     Optional second container (standalone.launcher.enabled) that shares
     the same pod and volumes. Mirrors the bash LLMDBENCH_VLLM_STANDALONE_LAUNCHER
     feature.
   ============================================================================ #}

{# Devices one replica is given. This is a Kubernetes fact, not an engine one:
   the kubelet grants devices before the engine process exists, so it is said in
   Kubernetes' own vocabulary and never inferred from a command line.

     standalone.resources.limits.<accelerator resource>   written as Kubernetes
       v (if unset)
     standalone.accelerator.count                         shorthand, per role
       v (if unset)
     accelerator.count                                    shorthand, plan-wide
       v (if unset)
     standalone.parallelism.tensor x dataLocal            what the chart was given

   A CPU scenario says `accelerator.count: 0`, which is also the switch that
   drops the accelerator nodeAffinity below.

   Mirrored by ``effective_accelerator_count`` in
   llmdbenchmark/parser/cluster_resource_resolver.py. #}
{% set standalone_accel_resource = (standalone.accelerator.resource if standalone.accelerator is defined and standalone.accelerator.resource is defined else accelerator.resource | default('')) %}
{% set standalone_stated_devices = standalone.resources.limits[standalone_accel_resource] if (standalone_accel_resource and standalone.resources.limits is defined and standalone.resources.limits[standalone_accel_resource] is defined) else none %}
{% set standalone_chart_gpus = (standalone.parallelism.tensor | int) * (standalone.parallelism.dataLocal | default(1, true) | int) %}
{% set standalone_shorthand_gpus = (standalone.accelerator.count | int) if (standalone.accelerator is defined and standalone.accelerator.count is defined) else ((accelerator.count | int) if (accelerator is defined and accelerator.count is defined) else standalone_chart_gpus) %}
{% set standalone_accel_count = (standalone_stated_devices | int) if standalone_stated_devices is not none else standalone_shorthand_gpus %}

apiVersion: apps/v1
kind: Deployment
metadata:
  name: standalone-{{ model_id_label }}
  labels:
    app: standalone-{{ model_id_label }}
{% if standalone.labels is defined %}
{% for key, value in standalone.labels.items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
{% if annotations is defined and annotations.common is defined and annotations.common %}
  annotations:
{% for key, value in annotations.common.items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
  namespace: {{ namespace.name }}
spec:
  replicas: {{ standalone.replicas }}
  selector:
    matchLabels:
      app: standalone-{{ model_id_label }}
  template:
    metadata:
      labels:
        app: standalone-{{ model_id_label }}
        llm-d.ai/inferenceServing: "{{ labels.inferenceServing }}"
        llm-d.ai/model: {{ model_id_label }}
        llm-d.ai/role: {{ standalone.role }}
{% if standalone.extraPodLabels is defined %}
{% for key, value in standalone.extraPodLabels.items() %}
        {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
{% if standalone.podAnnotations is defined and standalone.podAnnotations %}
      annotations:
{% for key, value in standalone.podAnnotations.items() %}
        {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}

    spec:
      schedulerName: {{ standalone.schedulerName }}
{% set pc = standalone.priorityClassName | default(engine.priorityClassName) %}
{% if pc and pc | lower != 'none' %}
      priorityClassName: {{ pc }}
{% endif %}
{% if engine.pullSecret is defined and engine.pullSecret %}
      imagePullSecrets:
      - name: {{ engine.pullSecret }}
{% endif %}
{% if standalone.nodeSelector is defined and standalone.nodeSelector %}
      nodeSelector:
{% for key, value in standalone.nodeSelector.items() %}
        {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
{% if standalone_accel_count > 0
  and standalone.acceleratorType is defined
  and standalone.acceleratorType.labelKey is defined
  and standalone.acceleratorType.labelKey
  and ((standalone.acceleratorType.labelValues is defined and standalone.acceleratorType.labelValues)
       or (standalone.acceleratorType.labelValue is defined and standalone.acceleratorType.labelValue)) %}
{# GPU scenario — use acceleratorType-based nodeAffinity #}
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
            - matchExpressions:
              - key: {{ standalone.acceleratorType.labelKey }}
                operator: In
                values:
{% if standalone.acceleratorType is defined and standalone.acceleratorType.labelValues is defined %}
{% for value in standalone.acceleratorType.labelValues %}
                - {{ value }}
{% endfor %}
{% elif standalone.acceleratorType is defined and standalone.acceleratorType.labelValue is defined %}
                - {{ standalone.acceleratorType.labelValue }}
{% endif %}
{% elif affinity is defined and affinity.enabled and affinity.nodeSelector is defined and affinity.nodeSelector %}
{# CPU / non-GPU scenario — use top-level affinity nodeSelector as nodeAffinity #}
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
            - matchExpressions:
{% for key, value in affinity.nodeSelector.items() %}
              - key: {{ key }}
                operator: In
                values:
                - "{{ value }}"
{% endfor %}
{% endif %}
{# The version_resolver expands `imageKey` into `image` and resolves any
   `:auto` tag before this template runs.  Backfill the empty case here. #}
{% if standalone.initContainers is defined and standalone.initContainers %}
      initContainers:
{% for container in standalone.initContainers %}
{% if not container.image %}
{% set _ = container.update({'image': images.benchmark.repository ~ ':' ~ images.benchmark.tag}) %}
{% endif %}
      - name: {{ container.name }}
        image: {{ container.image }}
{% if container.imagePullPolicy is defined %}
        imagePullPolicy: {{ container.imagePullPolicy }}
{% endif %}
{% if container.command is defined %}
        command:
{% for cmd in container.command %}
        - {{ cmd }}
{% endfor %}
{% endif %}
{% if container.args is defined %}
        args:
{% for arg in container.args %}
        - {{ arg }}
{% endfor %}
{% endif %}
{# Propagate core env vars to init containers -- same as modelservice #}
{% if container.env is defined and container.env %}
        env:
{% for env in container.env %}
        - name: {{ env.name }}
{% if env.value is defined %}
          value: "{{ env.value }}"
{% elif env.valueFrom is defined %}
          valueFrom:
{{ env.valueFrom | toyaml | indent(12) }}
{% endif %}
{% endfor %}
{% else %}
        env:
        - name: HOME
          value: "{{ engine.containerHome }}"
        # Workaround for https://github.com/vllm-project/vllm/issues/44548
        # (vLLM v0.20.0+ with torch 2.11). torch._inductor's cache_dir() calls
        # getpass.getuser() -> pwd.getpwuid(uid), which raises KeyError on
        # OpenShift's random UIDs that aren't in the container's /etc/passwd.
        # Setting USER bypasses the lookup; the value is arbitrary.
        - name: USER
          value: "llm-d"
        - name: HF_HOME
          value: "{{ engine.hfHome }}"
        # The ports the engine binds and the Service exposes. Emitted so an
        # engine command can write `--port $ENGINE_PORT` rather than repeat the
        # number, and so a preprocess script can find both. No engine
        # parameters are emitted -- the command states them itself. Engine-
        # specific environment (NIXL side channel, UCX, SGLang disaggregation,
        # ...) belongs in standalone.extraEnvVars.
        - name: ENGINE_PORT
          value: "{{ standalone.engine.port | default(engine.servicePort) }}"
        - name: SERVICE_PORT
          value: "{{ engine.servicePort }}"
        - name: DP_SIZE
          value: "{{ (standalone.parallelism.data if standalone.parallelism is defined and standalone.parallelism.data is defined else '1') }}"
        - name: TP_SIZE
          value: "{{ (standalone.parallelism.tensor if standalone.parallelism is defined and standalone.parallelism.tensor is defined else '1') }}"
        - name: DP_SIZE_LOCAL
          value: "{{ (standalone.parallelism.dataLocal if standalone.parallelism is defined and standalone.parallelism.dataLocal is defined else '1') }}"
        - name: POD_IP
          valueFrom:
            fieldRef:
              apiVersion: v1
              fieldPath: status.podIP
        - name: LLMDBENCH_POD_NS
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
{% if standalone.extraEnvVars is defined and standalone.extraEnvVars %}
{% for extra in standalone.extraEnvVars %}
        - name: {{ extra.name }}
{% if extra.value is defined %}
          value: "{{ extra.value }}"
{% elif extra.valueFrom is defined %}
          valueFrom:
{{ extra.valueFrom | toyaml | indent(12) }}
{% endif %}
{% endfor %}
{% endif %}
{% endif %}
{% if container.volumeMounts is defined %}
        volumeMounts:
{% for mount in container.volumeMounts %}
        - name: {{ mount.name }}
          mountPath: {{ mount.mountPath }}
{% if mount.readOnly is defined %}
          readOnly: {{ mount.readOnly | lower }}
{% endif %}
{% endfor %}
{% endif %}
{% if container.resources is defined %}
        resources:
{{ container.resources | toyaml | indent(10) }}
{% endif %}
{% endfor %}
{% endif %}
      containers:
{# ===== THE SERVING CONTAINER =====
   Named from `standalone.engine.containerName`, which resolves to llm-d's
   engine-neutral `modelserver`. A pod running SGLang should not carry a
   container called vllm-*, and `kubectl logs -c modelserver` then reads the
   same whichever engine the command launches. #}
      - name: {{ standalone.engine.containerName | default('modelserver', true) }}
        image: {{ standalone.engine.image.repository }}:{{ standalone.engine.image.tag }}
        imagePullPolicy: {{ standalone.engine.image.pullPolicy }}
{% set standalone_model_command = standalone.engine.modelCommand | default('custom') %}
{% if standalone_model_command == 'custom' %}
        command:
        - {{ engine.shell }}
        - "-c"
        args:
        - |
{{ render_engine_command('standalone') | indent(10, first=True) }}
{% elif standalone.engine.args is defined and standalone.engine.args %}
{# imageDefault: no `command:` -- the image entrypoint runs. Required for
   distroless server images that ship no shell to exec `<shell> -c`. #}
        args:
{{ standalone.engine.args | toyaml | indent(8, true) }}
{% endif %}
        env:
{# No LLMDBENCH_VLLM_* here. The model is already MODEL_NAME/MODEL_PATH below,
   and the accelerator used to be published as a "nvidia.com/gpu:<key>:<value>"
   string for one consumer -- the optional vLLM loader preprocess -- which only
   wanted the GPU's name and now reads it from nvidia-smi, which reports it
   anyway. Nothing engine-specific is emitted: the command states it. #}
{% if huggingface.enabled and huggingface.secretName is defined and huggingface.secretName %}
        - name: HUGGING_FACE_HUB_TOKEN
          valueFrom:
            secretKeyRef:
              name: {{ huggingface.secretName }}
              key: {{ huggingface.tokenKey }}
{% endif %}
        - name: HOME
          value: "{{ engine.containerHome }}"
        # Workaround for https://github.com/vllm-project/vllm/issues/44548:
        # vLLM v0.20.0+ (torch 2.11) calls getpass.getuser() at import time,
        # which raises KeyError under OpenShift's restricted-v2 SCC (random
        # UID not in /etc/passwd). Setting USER bypasses the pwd lookup; the
        # value is arbitrary. Without this the standalone pod CrashLoopBackOffs
        # on restricted-v2 (CI) while running fine under anyuid (dev ns).
        - name: USER
          value: "llm-d"
        - name: HF_HOME
          value: "{{ engine.hfHome }}"
        - name: MODEL_NAME
          value: "{{ model.name }}"
        - name: MODEL_PATH
          value: "{{ model.path }}"
{% if standalone.mountModelVolume and model.hubCacheSubdir %}
        {# The staged Hugging Face hub cache on the mounted model volume. With
           this set, the plain model id in the command resolves against the bytes
           the download job already wrote instead of being re-pulled from the Hub
           at pod start. The modelservice chart does the same thing for its own
           pods; standalone has no chart, so it is set here. #}
        - name: HF_HUB_CACHE
          value: "{{ standalone.modelMountPath }}/{{ model.hubCacheSubdir }}"
{% endif %}
        # The ports the engine binds and the Service exposes. Emitted so an
        # engine command can write `--port $ENGINE_PORT` rather than repeat the
        # number, and so a preprocess script can find both. No engine
        # parameters are emitted -- the command states them itself. Engine-
        # specific environment (NIXL side channel, UCX, SGLang disaggregation,
        # ...) belongs in standalone.extraEnvVars.
        - name: ENGINE_PORT
          value: "{{ standalone.engine.port | default(engine.servicePort) }}"
        - name: SERVICE_PORT
          value: "{{ engine.servicePort }}"
        - name: POD_IP
          valueFrom:
            fieldRef:
              apiVersion: v1
              fieldPath: status.podIP
        - name: LLMDBENCH_POD_NS
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
{% if standalone.podLabels is defined and standalone.podLabels %}
        - name: LLMDBENCH_POD_LABELS
          value: "{{ standalone.podLabels }}"
{% endif %}
{% if standalone.extraEnvVars is defined %}
{% for env in standalone.extraEnvVars %}
        - name: {{ env.name }}
{% if env.value is defined %}
          value: "{{ env.value }}"
{% elif env.valueFrom is defined %}
          valueFrom:
{% if env.valueFrom.secretKeyRef is defined %}
            secretKeyRef:
              name: {{ env.valueFrom.secretKeyRef.name }}
              key: {{ env.valueFrom.secretKeyRef.key }}
{% elif env.valueFrom.configMapKeyRef is defined %}
            configMapKeyRef:
              name: {{ env.valueFrom.configMapKeyRef.name }}
              key: {{ env.valueFrom.configMapKeyRef.key }}
{% elif env.valueFrom.fieldRef is defined %}
            fieldRef:
              fieldPath: {{ env.valueFrom.fieldRef.fieldPath }}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
        ports:
        - containerPort: {{ standalone.engine.port }}
          name: metrics
        startupProbe:
          httpGet:
            path: {{ standalone.probes.startup.path | default(standalone.engine.healthPath | default('/health', true), true) }}
            port: {{ standalone.engine.port }}
          failureThreshold: {{ standalone.probes.startup.failureThreshold }}
          initialDelaySeconds: {{ standalone.probes.startup.initialDelaySeconds }}
          periodSeconds: {{ standalone.probes.startup.periodSeconds }}
          timeoutSeconds: {{ standalone.probes.startup.timeoutSeconds }}
        livenessProbe:
          tcpSocket:
            port: {{ standalone.engine.port }}
          failureThreshold: {{ standalone.probes.liveness.failureThreshold }}
          periodSeconds: {{ standalone.probes.liveness.periodSeconds }}
{% if standalone.probes.liveness.timeoutSeconds %}
          timeoutSeconds: {{ standalone.probes.liveness.timeoutSeconds }}
{% endif %}
        readinessProbe:
          httpGet:
            path: {{ standalone.probes.readiness.path | default(standalone.engine.healthPath | default('/health', true), true) }}
            port: {{ standalone.engine.port }}
          failureThreshold: {{ standalone.probes.readiness.failureThreshold }}
          periodSeconds: {{ standalone.probes.readiness.periodSeconds }}
{% if standalone.probes.readiness.timeoutSeconds %}
          timeoutSeconds: {{ standalone.probes.readiness.timeoutSeconds }}
{% endif %}
        resources:
          limits:
            memory: {{ standalone.resources.limits.memory }}
            cpu: "{{ standalone.resources.limits.cpu }}"
{% if standalone_accel_resource and standalone_accel_count > 0 %}
            {{ standalone_accel_resource }}: "{{ standalone_accel_count }}"
{% endif %}
{% set eph_storage = standalone.ephemeralStorage | default(engine.ephemeralStorage) %}
{% set eph_resource = engine.ephemeralStorageResource %}
{% if eph_storage and eph_resource %}
            {{ eph_resource }}: "{{ eph_storage }}"
{% endif %}
{% set net_resource = standalone.networkResource | default(engine.networkResource) %}
{% set net_nr = standalone.networkNr | default(engine.networkNr) %}
{% if net_resource and net_nr %}
            {{ net_resource }}: "{{ net_nr }}"
{% endif %}
          requests:
            memory: {{ standalone.resources.requests.memory }}
            cpu: "{{ standalone.resources.requests.cpu }}"
{% if standalone_accel_resource and standalone_accel_count > 0 %}
            {{ standalone_accel_resource }}: "{{ standalone_accel_count }}"
{% endif %}
{% if eph_storage and eph_resource %}
            {{ eph_resource }}: "{{ eph_storage }}"
{% endif %}
{% if net_resource and net_nr %}
            {{ net_resource }}: "{{ net_nr }}"
{% endif %}
        volumeMounts:
{# Dynamic volume mounts from engine (shared base — preprocesses, dshm, etc.) #}
{% for mount in engine.volumeMounts %}
        - name: {{ mount.name }}
          mountPath: {{ mount.mountPath }}
{% if mount.subPath is defined %}
          subPath: {{ mount.subPath }}
{% endif %}
{% if mount.readOnly is defined %}
          readOnly: {{ mount.readOnly | lower }}
{% endif %}
{% endfor %}
{# Conditional model storage volume mount #}
{% if standalone.mountModelVolume %}
        - name: model-cache
          mountPath: {{ standalone.modelMountPath }}
          readOnly: true
{% endif %}
{# Additional volume mounts (per-deployment extras) #}
{% if standalone.additionalVolumeMounts is defined %}
{% for mount in standalone.additionalVolumeMounts %}
        - name: {{ mount.name }}
          mountPath: {{ mount.mountPath }}
{% if mount.subPath is defined %}
          subPath: {{ mount.subPath }}
{% endif %}
{% if mount.readOnly is defined %}
          readOnly: {{ mount.readOnly | lower }}
{% endif %}
{% endfor %}
{% endif %}
{% if standalone.extraContainerConfig is defined and standalone.extraContainerConfig %}
{{ standalone.extraContainerConfig | toyaml | indent(8) }}
{% endif %}
{# ===== LAUNCHER CONTAINER (optional second container sharing same pod) ===== #}
{# Mirrors bash LLMDBENCH_VLLM_STANDALONE_LAUNCHER feature.                   #}
{# Shares same volumes, env vars, and resources as the main container.         #}
{% if standalone.launcher is defined and standalone.launcher.enabled %}
      - name: launcher-{{ model_id_label }}
        image: {{ standalone.launcher.image.repository | default(standalone.engine.image.repository) }}:{{ standalone.launcher.image.tag | default(standalone.engine.image.tag) }}
        imagePullPolicy: {{ standalone.launcher.imagePullPolicy }}
        command:
        - {{ engine.shell }}
        - "-c"
        args:
        - |
{% if standalone.launcher.customPreprocessCommand is defined and standalone.launcher.customPreprocessCommand is not none %}
{{ standalone.launcher.customPreprocessCommand | indent(10, first=True) }}
{% endif %}
{% if standalone.launcher.args is defined and standalone.launcher.args is not none %}
{{ standalone.launcher.args | indent(10, first=True) }}
{% else %}
          uvicorn launcher:app --host 0.0.0.0 --log-level info --port {{ standalone.launcher.port }}
{% endif %}
        env:
{# No LLMDBENCH_VLLM_* here. The model is already MODEL_NAME/MODEL_PATH below,
   and the accelerator used to be published as a "nvidia.com/gpu:<key>:<value>"
   string for one consumer -- the optional vLLM loader preprocess -- which only
   wanted the GPU's name and now reads it from nvidia-smi, which reports it
   anyway. Nothing engine-specific is emitted: the command states it. #}
{% if huggingface.enabled and huggingface.secretName is defined and huggingface.secretName %}
        - name: HUGGING_FACE_HUB_TOKEN
          valueFrom:
            secretKeyRef:
              name: {{ huggingface.secretName }}
              key: {{ huggingface.tokenKey }}
{% endif %}
        - name: HOME
          value: "{{ engine.containerHome }}"
        - name: HF_HOME
          value: "{{ engine.hfHome }}"
{% if standalone.mountModelVolume and model.hubCacheSubdir %}
        {# The staged Hugging Face hub cache on the mounted model volume. With
           this set, the plain model id in the command resolves against the bytes
           the download job already wrote instead of being re-pulled from the Hub
           at pod start. The modelservice chart does the same thing for its own
           pods; standalone has no chart, so it is set here. #}
        - name: HF_HUB_CACHE
          value: "{{ standalone.modelMountPath }}/{{ model.hubCacheSubdir }}"
{% endif %}
        # The ports the engine binds and the Service exposes. Emitted so an
        # engine command can write `--port $ENGINE_PORT` rather than repeat the
        # number, and so a preprocess script can find both. No engine
        # parameters are emitted -- the command states them itself. Engine-
        # specific environment (NIXL side channel, UCX, SGLang disaggregation,
        # ...) belongs in standalone.extraEnvVars.
        - name: ENGINE_PORT
          value: "{{ standalone.engine.port | default(engine.servicePort) }}"
        - name: SERVICE_PORT
          value: "{{ engine.servicePort }}"
        - name: POD_IP
          valueFrom:
            fieldRef:
              apiVersion: v1
              fieldPath: status.podIP
        - name: LLMDBENCH_POD_NS
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
{% if standalone.podLabels is defined and standalone.podLabels %}
        - name: LLMDBENCH_POD_LABELS
          value: "{{ standalone.podLabels }}"
{% endif %}
{% if standalone.extraEnvVars is defined %}
{% for env in standalone.extraEnvVars %}
        - name: {{ env.name }}
{% if env.value is defined %}
          value: "{{ env.value }}"
{% elif env.valueFrom is defined %}
          valueFrom:
{% if env.valueFrom.secretKeyRef is defined %}
            secretKeyRef:
              name: {{ env.valueFrom.secretKeyRef.name }}
              key: {{ env.valueFrom.secretKeyRef.key }}
{% elif env.valueFrom.configMapKeyRef is defined %}
            configMapKeyRef:
              name: {{ env.valueFrom.configMapKeyRef.name }}
              key: {{ env.valueFrom.configMapKeyRef.key }}
{% elif env.valueFrom.fieldRef is defined %}
            fieldRef:
              fieldPath: {{ env.valueFrom.fieldRef.fieldPath }}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
        ports:
        - containerPort: {{ standalone.launcher.port }}
{# Launcher probes: startup/readiness use the engine port, liveness the launcher port #}
        startupProbe:
          httpGet:
            path: {{ standalone.probes.startup.path | default(standalone.engine.healthPath | default('/health', true), true) }}
            port: {{ standalone.engine.port }}
          failureThreshold: {{ standalone.probes.startup.failureThreshold }}
          initialDelaySeconds: {{ standalone.probes.startup.initialDelaySeconds }}
          periodSeconds: 30
          timeoutSeconds: 5
        livenessProbe:
          tcpSocket:
            port: {{ standalone.launcher.port }}
          failureThreshold: 3
          periodSeconds: 10
{% if standalone.probes.liveness.timeoutSeconds %}
          timeoutSeconds: {{ standalone.probes.liveness.timeoutSeconds }}
{% endif %}
        readinessProbe:
          httpGet:
            path: {{ standalone.probes.readiness.path | default(standalone.engine.healthPath | default('/health', true), true) }}
            port: {{ standalone.engine.port }}
          failureThreshold: 3
          periodSeconds: 5
{% if standalone.probes.readiness.timeoutSeconds %}
          timeoutSeconds: {{ standalone.probes.readiness.timeoutSeconds }}
{% endif %}
        resources:
          limits:
            memory: {{ standalone.resources.limits.memory }}
            cpu: "{{ standalone.resources.limits.cpu }}"
{% if standalone_accel_resource and standalone_accel_count > 0 %}
            {{ standalone_accel_resource }}: "{{ standalone_accel_count }}"
{% endif %}
{% if eph_storage and eph_resource %}
            {{ eph_resource }}: "{{ eph_storage }}"
{% endif %}
{% if net_resource and net_nr %}
            {{ net_resource }}: "{{ net_nr }}"
{% endif %}
          requests:
            memory: {{ standalone.resources.requests.memory }}
            cpu: "{{ standalone.resources.requests.cpu }}"
{% if standalone_accel_resource and standalone_accel_count > 0 %}
            {{ standalone_accel_resource }}: "{{ standalone_accel_count }}"
{% endif %}
{% if eph_storage and eph_resource %}
            {{ eph_resource }}: "{{ eph_storage }}"
{% endif %}
{% if net_resource and net_nr %}
            {{ net_resource }}: "{{ net_nr }}"
{% endif %}
{# Launcher shares same volume mounts as main container #}
        volumeMounts:
{% for mount in engine.volumeMounts %}
        - name: {{ mount.name }}
          mountPath: {{ mount.mountPath }}
{% if mount.subPath is defined %}
          subPath: {{ mount.subPath }}
{% endif %}
{% if mount.readOnly is defined %}
          readOnly: {{ mount.readOnly | lower }}
{% endif %}
{% endfor %}
{% if standalone.mountModelVolume %}
        - name: model-cache
          mountPath: {{ standalone.modelMountPath }}
          readOnly: true
{% endif %}
{% if standalone.additionalVolumeMounts is defined %}
{% for mount in standalone.additionalVolumeMounts %}
        - name: {{ mount.name }}
          mountPath: {{ mount.mountPath }}
{% if mount.subPath is defined %}
          subPath: {{ mount.subPath }}
{% endif %}
{% if mount.readOnly is defined %}
          readOnly: {{ mount.readOnly | lower }}
{% endif %}
{% endfor %}
{% endif %}
{% endif %}
{# ===== VOLUMES (pod-level, shared by all containers) ===== #}
      volumes:
{# Dynamic volumes from engine (shared base — dshm, preprocesses, etc.) #}
{% for volume in engine.volumes %}
      - name: {{ volume.name }}
{% if volume.type == 'configMap' %}
        configMap:
          name: {{ volume.configMap.name }}
{% if volume.configMap.defaultMode is defined %}
          defaultMode: {{ volume.configMap.defaultMode }}
{% endif %}
{% elif volume.type == 'emptyDir' %}
        emptyDir:
{% if volume.emptyDir.medium is defined %}
          medium: {{ volume.emptyDir.medium }}
{% endif %}
{% if volume.emptyDir.sizeLimit is defined %}
          sizeLimit: {{ volume.emptyDir.sizeLimit }}
{% endif %}
{% elif volume.type == 'persistentVolumeClaim' %}
        persistentVolumeClaim:
          claimName: {{ volume.persistentVolumeClaim.claimName }}
{% elif volume.type == 'secret' %}
        secret:
          secretName: {{ volume.secret.secretName }}
{% if volume.secret.defaultMode is defined %}
