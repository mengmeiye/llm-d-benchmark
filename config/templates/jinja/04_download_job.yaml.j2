{% if not (storage.hostPath is defined and storage.hostPath.enabled | default(false)) %}
apiVersion: batch/v1
kind: Job
metadata:
  name: {{ downloadJob.name }}
  namespace: {{ namespace.name }}
spec:
  backoffLimit: {{ downloadJob.backoffLimit }}
  template:
    metadata:
      namespace: {{ namespace.name }}
      labels:
        app: {{ labels.app }}
    spec:
      containers:
        - name: downloader
          image: {{ images.benchmark.repository }}:{{ images.benchmark.tag }}
          # Without this, a :latest tag makes Kubernetes default to
          # imagePullPolicy: Always, so the node re-pulls the whole image on every
          # standup even when it is already cached. That is invisible for a small
          # image but not for a large one: with an agentic harness image (an agent
          # CLI plus a multi-language toolchain, several GB) the pull outlived the
          # download job's own timeout, so the job failed before transferring a
          # single byte of weights -- surfacing as a weight-download timeout that
          # points at storage or HuggingFace rather than at an image pull.
          #
          # IfNotPresent rather than changing which image this job runs: the pull
          # policy is the actual cause, it is one line, and it keeps working
          # whatever image a user points images.benchmark at. A user can also pin
          # a hard version tag to get the same effect, but that is a workaround
          # for a default that is wrong for this job -- nothing here needs a fresh
          # pull, since the container only downloads the model and exits.
          imagePullPolicy: IfNotPresent
          command: ["/bin/sh", "-c"]
{# What gets staged depends on how the engine will be told to find it.

    pvc+hf (model.hubCacheSubdir set): a Hugging Face *hub cache*.
      `hf download <id>` with HF_HUB_CACHE set writes
      models--<org>--<model>/snapshots/<sha>/..., which is the only layout a
      plain model id resolves against. The modelservice chart points the engine
      at the same subdirectory of the same volume, so `vllm serve <id>` reads
      these bytes instead of reaching for the Hub.

    pvc: a flat directory of one model's files at model.path, because the engine
      is given that path rather than an id.

    Either way the directory is composed from THIS container's mount path: the
    subdirectory is a fact about the volume, and every container that touches it
    sees the volume somewhere else -- the job here at `downloadJob.mountPath`,
    the serving pods where the modelservice chart mounts it, the hostPath
    DaemonSet through the node filesystem. #}
          args:
{% if model.hubCacheSubdir %}
            - |
              mkdir -p "${HF_HUB_CACHE}" && \
              hf download "${HF_MODEL_ID}" --max-workers {{ downloadJob.maxWorkers }}
{% else %}
            - |
              mkdir -p "${MOUNT_PATH}/${MODEL_PATH}" && \
              hf download "${HF_MODEL_ID}" --local-dir "${MOUNT_PATH}/${MODEL_PATH}" --max-workers {{ downloadJob.maxWorkers }}
{% endif %}
          env:
            - name: MODEL_PATH
              value: {{ model.path }}
            - name: HF_MODEL_ID
              value: {{ model.huggingfaceId }}
{% if model.hubCacheSubdir %}
            - name: HF_HUB_CACHE
              value: {{ downloadJob.mountPath }}/{{ model.hubCacheSubdir }}
{% endif %}
{% if huggingface.enabled %}
            - name: HF_TOKEN
              valueFrom:
                secretKeyRef:
                  name: {{ huggingface.secretName }}
                  key: {{ huggingface.tokenKey }}
{% endif %}
            - name: HF_HOME
              value: /tmp/huggingface
            - name: HOME
              value: /tmp
            - name: MOUNT_PATH
              value: {{ downloadJob.mountPath }}
          volumeMounts:
            - name: model-cache
              mountPath: {{ downloadJob.mountPath }}
      restartPolicy: OnFailure
{% if engine.pullSecret is defined and engine.pullSecret %}
      imagePullSecrets:
        - name: {{ engine.pullSecret }}
{% endif %}
      volumes:
        - name: model-cache
          persistentVolumeClaim:
            claimName: {{ storage.modelPvc.name }}
{% endif %}
