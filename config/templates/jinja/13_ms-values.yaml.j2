{# Modelservice-only template. -t kustomize uses upstream guide manifests. #}
{% if standalone.enabled is defined and not standalone.enabled and not (kustomize.enabled | default(false)) %}

{# ============================================================================
   ms-values.yaml.j2

   Comprehensive modelservice values template matching the official helm chart.
   See: https://github.com/llm-d/llm-d-modelservice
   ============================================================================ #}


{# -------------------------------------------------------------------------- #}
{# COMMON / TOP-LEVEL CONFIGURATION                                           #}
{# -------------------------------------------------------------------------- #}
{% if common is defined and common %}
common:
{{ common | toyaml | indent(2) }}
{% endif %}

fullnameOverride: {{ model_id_label }}

{% if serviceAccountOverride is defined and serviceAccountOverride %}
serviceAccountOverride: {{ serviceAccountOverride }}
{% endif %}

{% if schedulerName is defined %}
schedulerName: {{ schedulerName }}
{% else %}
schedulerName: default-scheduler
{% endif %}

{# -------------------------------------------------------------------------- #}
{# MODEL ARTIFACTS                                                            #}
{# -------------------------------------------------------------------------- #}
modelArtifacts:
  name: {{ model.name }}
{# Three protocols, three things the chart hands the engine as its model
    argument. `hf` and `pvc+hf` both give it the plain model id (and the HF cache
    env to resolve it); `pvc` gives it a path into the volume. See
    `modelservice.uriProtocol` in defaults.yaml. #}
{% set _uri_protocol = (modelservice.uriProtocol | default('pvc+hf')) if modelservice is defined else 'pvc+hf' %}
{% if _uri_protocol == 'hf' %}
  uri: hf://{{ model.huggingfaceId | default(model.name) }}
{% elif _uri_protocol == 'pvc' %}
  uri: pvc://{{ storage.modelPvc.name }}/{{ model.path }}
{% else %}
  uri: pvc+hf://{{ storage.modelPvc.name }}/{{ model.path }}
{# The chart mounts a pvc* model volume read-only by default, and its own
    values.yaml says to turn that off for pvc+hf "when Hugging Face cache writes
    are needed". They are: resolving a plain model id goes through
    huggingface_hub's cache logic, which takes a lock under `.locks/` and
    refreshes `refs/<revision>` before it hands back the snapshot path. Those
    writes land inside HF_HUB_CACHE, i.e. inside this volume. A raw `pvc`
    directory is read as a plain path with none of that, so it keeps the
    read-only default. #}
  readOnly: false
{% endif %}
  size: {{ model.size }}
{% if huggingface.enabled and huggingface.secretName is defined and huggingface.secretName %}
  authSecretName: "{{ huggingface.secretName }}"
{% endif %}
  mountPath: /model-cache
  labels:
    llm-d.ai/inferenceServing: "{{ labels.inferenceServing }}"
    llm-d.ai/model: {{ model_id_label }}
{% set _ms_guide_label = wva.wellLitPath
                        if (wva is defined and wva.enabled | default(false))
                        else ((kustomize.guideName if kustomize is defined and kustomize.guideName else '') or scenarioName) %}
    llm-d.ai/guide: "{{ _ms_guide_label }}"
{% if wva is defined and wva.enabled | default(false) and not (fma is defined and fma.enabled | default(false)) %}
    # WVA needs the variant label on the scrape target so the saturation
    # engine can join Prometheus series back to the VariantAutoscaling.
    # FMA path stamps this on launcher pods via 24_fma-deployment.yaml.j2;
    # for the modelservice (decode) path we stamp it here so baseline
    # scenarios (WVA without FMA) hit METRICSREADY=True.
    llm-d.ai/variant: "{{ model_id_label }}-decode"
{% endif %}
{% if modelArtifacts is defined and modelArtifacts.extraLabels is defined %}
{% for key, value in modelArtifacts.extraLabels.items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}

{# -------------------------------------------------------------------------- #}
{# MULTINODE (LeaderWorkerSet)                                                #}
{# -------------------------------------------------------------------------- #}
{% if multinode is defined and multinode.enabled is defined %}
multinode: {{ multinode.enabled | lower }}
{% else %}
multinode: false
{% endif %}

{# -------------------------------------------------------------------------- #}
{# ACCELERATOR CONFIGURATION                                                  #}
{# -------------------------------------------------------------------------- #}
accelerator:
{% if accelerator.count is defined and accelerator.count | int == 0 %}
  type: cpu
{% else %}
  type: {{ accelerator.type | default('nvidia') }}
{% endif %}
{% if accelerator.resources is defined %}
  resources:
{{ accelerator.resources | toyaml | indent(4, first=True) }}
{% elif accelerator.type is defined and accelerator.resource is defined and accelerator.type != 'nvidia' %}
  resources:
    {{ accelerator.type }}: "{{ accelerator.resource }}"
{% endif %}
{% if accelerator.env is defined %}
  env:
{{ accelerator.env | toyaml | indent(4, first=True) }}
{% endif %}

{# -------------------------------------------------------------------------- #}
{# ACCELERATOR DRA (Dynamic Resource Allocation)                              #}
{# -------------------------------------------------------------------------- #}
{% if dra is defined and dra.enabled is defined %}
  dra: {{ dra.enabled | lower }}
{% endif %}
{% if dra is defined and dra.claimTemplates is defined %}
  resourceClaimTemplates:
{{ dra.claimTemplates | toyaml | indent(4, first=True) }}
{% endif %}

{# -------------------------------------------------------------------------- #}
{# TRACING (OpenTelemetry)                                                    #}
{# -------------------------------------------------------------------------- #}
{% if tracing is defined and tracing.enabled is defined %}
tracing:
  enabled: {{ tracing.enabled | lower }}
{% if tracing.otlpEndpoint is defined %}
  otlpEndpoint: "{{ tracing.otlpEndpoint }}"
{% endif %}
{% if tracing.sampling is defined %}
  sampling:
{% if tracing.sampling.sampler is defined %}
    sampler: "{{ tracing.sampling.sampler }}"
{% endif %}
{% if tracing.sampling.samplerArg is defined %}
    samplerArg: "{{ tracing.sampling.samplerArg }}"
{% endif %}
{% endif %}
{% if tracing.serviceNames is defined %}
  serviceNames:
{% if tracing.serviceNames.vllmDecode is defined %}
    vllmDecode: "{{ tracing.serviceNames.vllmDecode }}"
{% endif %}
{% if tracing.serviceNames.vllmPrefill is defined %}
    vllmPrefill: "{{ tracing.serviceNames.vllmPrefill }}"
{% endif %}
{% if tracing.serviceNames.routingProxy is defined %}
    routingProxy: "{{ tracing.serviceNames.routingProxy }}"
{% endif %}
{% endif %}
{% if tracing.vllm is defined %}
  vllm:
{% if tracing.vllm.collectDetailedTraces is defined %}
    collectDetailedTraces: "{{ tracing.vllm.collectDetailedTraces }}"
{% endif %}
{% endif %}
{% endif %}

{# -------------------------------------------------------------------------- #}
{# ROUTING / PROXY CONFIGURATION                                              #}
{# -------------------------------------------------------------------------- #}
routing:
  servicePort: {{ routing.servicePort }}
  proxy:
{% if routing.proxy is defined and routing.proxy.enabled is defined %}
    enabled: {{ routing.proxy.enabled | lower }}
{% else %}
    enabled: true
{% endif %}
    image: "{{ images.routingSidecar.repository }}:{{ images.routingSidecar.tag }}"
{% if routing.proxy is defined and routing.proxy.imagePullPolicy is defined %}
    imagePullPolicy: {{ routing.proxy.imagePullPolicy }}
{% else %}
    imagePullPolicy: Always
{% endif %}
{# The sidecar forwards to wherever decode's engine actually listens, i.e. the
   --port in decode's engine command. routing.proxy.targetPort is kept in sync
   with it by the render pipeline, so this is one value read two ways. #}
    targetPort: {{ routing.proxy.targetPort | default(resolvedServingRoles.decode.port, true) }}
    connector: {{ routing.connector }}
    secure: {{ routing.secure | lower }}
{% if routing.proxy is defined %}
{% if routing.proxy.prefillerUseTLS is defined %}
    prefillerUseTLS: {{ routing.proxy.prefillerUseTLS | lower }}
{% endif %}
{% if routing.proxy.certPath is defined %}
    certPath: "{{ routing.proxy.certPath }}"
{% endif %}
{% if routing.proxy.zapDevel is defined %}
    zapDevel: {{ routing.proxy.zapDevel | lower }}
{% endif %}
{% if routing.proxy.zapEncoder is defined %}
    zapEncoder: {{ routing.proxy.zapEncoder }}
{% endif %}
{% if routing.proxy.zapLogLevel is defined %}
    zapLogLevel: {{ routing.proxy.zapLogLevel }}
{% endif %}
{% if routing.proxy.zapStacktraceLevel is defined %}
    zapStacktraceLevel: {{ routing.proxy.zapStacktraceLevel }}
{% endif %}
{% if routing.proxy.zapTimeEncoding is defined %}
    zapTimeEncoding: {{ routing.proxy.zapTimeEncoding }}
{% endif %}
{% if routing.proxy.resources is defined %}
    resources:
{{ routing.proxy.resources | toyaml | indent(6, first=True) }}
{% endif %}
{% endif %}
{% if routing.debugLevel is defined %}
    debugLevel: {{ routing.debugLevel }}
{% endif %}

{# -------------------------------------------------------------------------- #}
{# REQUESTER (FMA - Fast Model Actuation)                                     #}
{# -------------------------------------------------------------------------- #}
{% if requester is defined and requester.enable is defined %}
requester:
  enable: {{ requester.enable | lower }}
{% if requester.enable %}
  image: "{{ requester.image }}"
{% if requester.adminPort is defined %}
  adminPort: {{ requester.adminPort }}
{% endif %}
{% if requester.port is defined %}
  port:
{{ requester.port | toyaml | indent(4) }}
{% endif %}
{% if requester.readinessProbe is defined %}
  readinessProbe:
{{ requester.readinessProbe | toyaml | indent(4) }}
{% endif %}
{% if requester.resources is defined %}
  resources:
{{ requester.resources | toyaml | indent(4) }}
{% endif %}
{% endif %}
{% endif %}

{# ========================================================================== #}
{# ENGINE ROLES                                                               #}
{# ========================================================================== #}
{# Both roles are rendered by modelservice_role in _macros.j2. #}
{{ modelservice_role('decode', decode) }}
{{ modelservice_role('prefill', prefill) }}
{# -------------------------------------------------------------------------- #}
{# EXTRA OBJECTS                                                              #}
{# -------------------------------------------------------------------------- #}
{% if extraObjects is defined and extraObjects %}
extraObjects:
{{ extraObjects | toyaml | indent(2, first=True) }}
{% endif %}

{% endif %}
