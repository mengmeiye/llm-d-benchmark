{% if nok8s.enabled %}
{% set serving = resolvedServingRoles.nok8s %}
{# ============================================================================
   nok8s container-launch spec.  This is NOT a Kubernetes object — it is an
   authored manifest describing which containers step_05_nok8s_deploy.py must
   launch (and step_06_nok8s_teardown.py must remove), plus the readiness
   probes and the endpoint URL the run phase benchmarks against.  Rendering the
   launch surface as data (rather than argv strings) keeps dry-run readable and
   lets the step build docker vs podman commands correctly.

   The engine worker's launch line is carried here verbatim, exactly as the
   scenario wrote it, and the step writes it to a file the container runs. That
   is what lets nok8s run any engine with any flags: neither this template nor
   the step has to know the spelling of either.
   ============================================================================ #}
runtime: {{ nok8s.runtime }}
{# Where the containers run, and how they are reached. "localhost" keeps every
   command local. For a remote node, transport "ssh" (the default) runs the
   runtime on the node over plain ssh, and "native" passes the URL to a local
   client (docker -H / podman --url). Both are recorded so teardown reaches the
   same daemon standup used. clientHost is resolved by
   RenderPlans._resolve_nok8s_connection so consumers never have to parse the
   URL. #}
connection: "{{ nok8s.connection | default('localhost') }}"
transport: "{{ nok8s.transport | default('ssh') }}"
sshIdentity: "{{ nok8s.sshIdentity | default('') }}"
sshArgs: [{% for a in nok8s.sshArgs | default([]) %}"{{ a }}"{% if not loop.last %}, {% endif %}{% endfor %}]
workspaceHostDir: "{{ nok8s.workspaceHostDir }}"
hfTokenEnv: {{ nok8s.hfTokenEnv }}
hfCacheDir: "{{ nok8s.engine.hfCacheDir }}"
model: {{ model.name }}
{# Two endpoints, because two different machines dial the front door:
   `endpoint` is used from *inside* the daemon host -- the harness container
   runs there with --network host, and keeping it on the node means the
   measured latency is the stack's, not the SSH link's.
   `clientEndpoint` is used from the machine running llmdbenchmark (smoketest,
   manual curl). They are identical for a local stack. #}
endpoint: "http://localhost:{{ nok8s.envoy.listenPort }}"
clientEndpoint: "http://{{ nok8s.clientHost | default('localhost') }}:{{ nok8s.envoy.listenPort }}"
readiness:
  enginePorts: [{% for i in range(nok8s.engine.replicas) %}{{ nok8s.engine.hostPort + i }}{% if not loop.last %}, {% endif %}{% endfor %}]
  envoyPort: {{ nok8s.envoy.listenPort }}
containers:
{% for i in range(nok8s.engine.replicas) %}
{# llm-d's engine-neutral container name: a worker running SGLang should not be
   called vllm-0. #}
  - name: modelserver-{{ i }}{{ nok8s.nameSuffix }}
    kind: engine
    engine: {{ serving.engineName | default('vllm', true) }}
    image: "{{ serving.image.repository }}:{{ serving.image.tag }}"
{# The command the container runs, byte-for-byte what the scenario wrote. The
   step writes it to <workspaceHostDir>/launch-<name>.sh and bind-mounts that,
   rather than inlining it in the `docker run` line: the command legitimately
   contains quotes and newlines (a --kv-transfer-config JSON blob, say), and
   under the ssh transport the whole run command is re-quoted once more. #}
    shell: {{ engine.shell }}
    command: |
{{ (serving.command | default('', true) | trim) | indent(6, true) }}
    hostPort: {{ nok8s.engine.hostPort + i }}
{# The port the engine binds inside the container: its command's --port. #}
    containerPort: {{ serving.port | default(engine.servicePort, true) }}
    accelerator: {{ nok8s.engine.accelerator | default('nvidia') }}
    gpus: "{{ nok8s.engine.gpus }}"
    deviceArgs: [{% for a in nok8s.engine.deviceArgs | default([]) %}"{{ a }}"{% if not loop.last %}, {% endif %}{% endfor %}]
    shmSize: "{{ nok8s.engine.shmSize }}"
{# Devices one worker is given, as stated in `nok8s.engine.acceleratorCount`
   -- the runtime pins them before the engine exists, so the count is not read
   out of the command. With replicas > 1 the step uses it to pin worker i to its
   own contiguous slice of the host's devices. #}
    acceleratorCount: {{ nok8s.engine.acceleratorCount | default(1, true) }}
    replicas: {{ nok8s.engine.replicas }}
    replicaIndex: {{ i }}
{% endfor %}
  - name: epp{{ nok8s.nameSuffix }}
    kind: epp
    image: "{{ nok8s.epp.image }}:{{ nok8s.epp.tag }}"
    grpcPort: {{ nok8s.epp.grpcPort }}
    grpcHealthPort: {{ nok8s.epp.grpcHealthPort }}
    metricsPort: {{ nok8s.epp.metricsPort }}
    poolName: {{ nok8s.epp.poolName }}
    poolNamespace: {{ nok8s.epp.poolNamespace }}
    configMountDir: {{ nok8s.epp.configMountDir }}
  - name: envoy{{ nok8s.nameSuffix }}
    kind: envoy
    image: "{{ nok8s.envoy.image }}:{{ nok8s.envoy.tag }}"
    listenPort: {{ nok8s.envoy.listenPort }}
    configMountPath: {{ nok8s.envoy.configMountPath }}
{# Hot-restart base ID, resolved by RenderPlans._resolve_nok8s_envoy_base_id.
   Envoy runs with --network host, so its default base ID of 0 is claimed
   host-wide and a second Envoy on the node dies before it binds. #}
    baseId: {{ nok8s.envoy.baseId | default(0) }}
{% endif %}
