{% if fma is defined and fma.enabled | default(false) %}

{# ============================================================================
   fma-deployment.yaml.j2

   Fast Model Actuation Deployment.
   ============================================================================ #}

apiVersion: fma.llm-d.ai/v1alpha1
kind: InferenceServerConfig
metadata:
  name: fma-{{ model_id_label }}
  labels:
    app: fma-{{ model_id_label }}
{% if fma.labels is defined %}
{% for key, value in fma.labels.items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
  namespace: {{ namespace.name }}
spec:
  launcherConfigName: fma-{{ model_id_label }}
  modelServerConfig:
    labels:
      component: inference
      # EPP InferencePool selector keys (see 12_router-values.yaml.j2:217-218):
      llm-d.ai/inferenceServing: "{{ labels.inferenceServing | default('true') }}"
      llm-d.ai/model: "{{ model_id_label }}"
{% set _fma_guide_label = wva.wellLitPath
                         if (wva is defined and wva.enabled | default(false))
                         else ((kustomize.guideName if kustomize is defined and kustomize.guideName else '') or scenarioName) %}
      llm-d.ai/guide: "{{ _fma_guide_label }}"
{% if wva is defined and wva.enabled | default(false) %}
      llm-d.ai/variant: "{{ model_id_label }}-fma"
{% endif %}
    env_vars:
      HF_HOME: "{{ fma.modelMountPath }}"
{% if model.hubCacheSubdir %}
      {# The hub cache the download job staged on the mounted PVC. HF_HUB_CACHE
         outranks HF_HOME for hub lookups, so `--model <repo id>` loads these
         bytes instead of re-resolving the repo over the network at weight load
         (#1822). There is no modelservice chart on the FMA path to inject it. #}
      HF_HUB_CACHE: "{{ fma.modelMountPath }}/{{ model.hubCacheSubdir }}"
{% endif %}
      VLLM_LOGGING_LEVEL: DEBUG
      VLLM_SERVER_DEV_MODE: "1"
      VLLM_USE_V1: "1"
{# The FMA launcher process IS the vLLM entrypoint -- it is what owns
   --enable-sleep-mode -- so this path has no `vllm serve` line to state: the
   LauncherConfig CRD takes a flag string instead of a command. That string is
   `fma.launcher.options`, passed through verbatim, exactly as `engine.command`
   is passed through verbatim everywhere else. Nothing here assembles flags.

   Write the numbers an FMA arm has to share with the arm it is compared against
   as `${model.maxModelLen}`, `${model.blockSize}`, `${model.gpuMemoryUtilization}`
   and they cannot desync. There is no command here for those to be read off, so
   this is the one path that states them in the scenario's `model:` block.

   `--model` is the repo ID, not a path: HF_HUB_CACHE above points at the hub
   cache the download job staged on the PVC, so the ID loads those bytes. It has
   to stay an ID regardless -- it feeds the derived Helm release name, and a path
   mangles that into an invalid (leading-dash) name. #}
    options: "{{ fma.launcher.options }}"
    port: 8000
---
apiVersion: fma.llm-d.ai/v1alpha1
kind: LauncherConfig
metadata:
  name: fma-{{ model_id_label }}
  labels:
    app: fma-{{ model_id_label }}
{% if fma.labels is defined %}
{% for key, value in fma.labels.items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
  namespace: {{ namespace.name }}
spec:
  maxInstances: {{ fma.launcher.maxInstances }}
  podTemplate:
    metadata:
{% if fma.launcher.podTemplate.metadata.labels is defined %}
      labels:
{% for key, value in fma.launcher.podTemplate.metadata.labels.items() %}
        {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
{% if fma.launcher.podTemplate.metadata.annotations is defined %}
      annotations:
{% for key, value in fma.launcher.podTemplate.metadata.annotations.items() %}
        {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
    spec:
      # SA granted pods get/patch so the state-change-reflector can patch its
      # own pod's serving state (Role in 25_fma-launcher-rbac.yaml.j2).
      serviceAccountName: fma-launcher
{% if fma.launcher.runtimeClassName is defined and fma.launcher.runtimeClassName %}
      runtimeClassName: {{ fma.launcher.runtimeClassName }}
{% endif %}
      containers:
        - name: inference-server
          image: {{ fma.launcher.image.repository }}:{{ fma.launcher.image.tag }}
          imagePullPolicy: {{ fma.launcher.image.pullPolicy }}
          command:
            - /bin/bash
            - "-c"
          args:
            - |
{% if fma.launcher.customPreprocessCommands is defined %}
{% for command in fma.launcher.customPreprocessCommands %}
              {{ command }}
{% endfor %}
{% endif %}
              exec python3 /app/launcher.py \
              --host 0.0.0.0 \
              --log-level info \
              --port={{ fma.launcherConfigurator.port }}
          env:
          - name: HOME
            value: "{{ fma.modelMountPath }}"
          - name: VLLM_CACHE_ROOT
            value: "{{ fma.modelMountPath }}/vllm"
          - name: FLASHINFER_WORKSPACE_DIR
            value: "{{ fma.modelMountPath }}/flashinfer"
          - name: TRITON_CACHE_DIR
            value: "{{ fma.modelMountPath }}/triton"
          - name: XDG_CACHE_HOME
            value: "{{ fma.modelMountPath }}"
          - name: XDG_CONFIG_HOME
            value: "{{ fma.modelMountPath }}/config"
          - name: HF_HOME
            value: "{{ fma.modelMountPath }}"
{% if model.hubCacheSubdir %}
          - name: HF_HUB_CACHE
            value: "{{ fma.modelMountPath }}/{{ model.hubCacheSubdir }}"
{% endif %}
{% if huggingface.enabled and huggingface.secretName is defined and huggingface.secretName %}
          - name: HF_TOKEN
            valueFrom:
              secretKeyRef:
                name: {{ huggingface.secretName }}
                key:  {{ huggingface.tokenKey }}
{% endif %}
          # NOTE: the launcher deliberately does NOT request a GPU. In the FMA
          # dual-pods model the requester reserves the GPU and the launcher
          # binds onto it; if the launcher also requested nvidia.com/gpu it would
          # double-book (N launchers + N requesters = 2N GPU requests on an
          # N-GPU node), leaving requesters Pending with Insufficient nvidia.com/gpu.
          volumeMounts:
{% if (fma.launcher.tensorParallelSize | default(1) | int) > 1 %}
          # A tensor-parallel launcher needs a real /dev/shm: vLLM's TP workers
          # exchange over a shared-memory message queue and the pod default 64Mi
          # crashes NCCL/multiproc at init. This is a pod-spec fact the kubelet
          # has to be told before the process exists, which is why the width is
          # stated here as well as written in `options`.
          - name: dshm
            mountPath: /dev/shm
{% endif %}
{% if fma.mountModelVolume %}
          - name: model-cache
            mountPath: {{ fma.modelMountPath }}
            readOnly: False
{% endif %}
      volumes:
{% if (fma.launcher.tensorParallelSize | default(1) | int) > 1 %}
      - name: dshm
        emptyDir:
          medium: Memory
          sizeLimit: 16Gi
{% endif %}
{% if fma.mountModelVolume %}
      - name: model-cache
        persistentVolumeClaim:
          claimName: {{ fma.modelPvcName }}
{% endif %}
---
apiVersion: fma.llm-d.ai/v1alpha1
kind: LauncherPopulationPolicy
metadata:
  name: fma-{{ model_id_label }}
  labels:
    app: fma-{{ model_id_label }}
{% if fma.labels is defined %}
{% for key, value in fma.labels.items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
  namespace: {{ namespace.name }}
spec:
  enhancedNodeSelector:
    labelSelector:
      matchLabels:
        nvidia.com/gpu.present: "true"
{% if fma.launcherNodeSelection is defined and fma.launcherNodeSelection.enabled | default(false) %}
        # Pin launchers to the single GPU node step_06 selected + labeled.
        {{ fma.launcherNodeSelection.nodeLabel | default('fma-hotstart') }}: "true"
{% endif %}
      # Skip unhealthy nodes
      matchExpressions:
        - key: nvidia.com/gpu.product
          operator: Exists
  countForLauncher:
    - launcherConfigName: fma-{{ model_id_label }}
      launcherCount: 1
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: fma-requester-{{ model_id_label }}
  labels:
    app: fma-requester-{{ model_id_label }}
{% if fma.labels is defined %}
{% for key, value in fma.labels.items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
  namespace: {{ namespace.name }}
spec:
  replicas: {{ fma.requester.replicas | default(0) }}
  selector:
    matchLabels:
      app: dp-app
      llm-d.ai/inference-serving: "true"
      llm-d.ai/model: {{ model_id_label }}
      llm-d.ai/role: requester
  template:
    metadata:
      labels:
        app: dp-app
        llm-d.ai/inference-serving: "true"
        llm-d.ai/model: {{ model_id_label }}
        llm-d.ai/role: requester
      annotations:
        dual-pods.llm-d.ai/admin-port: "8081"
        dual-pods.llm-d.ai/inference-server-config: fma-{{ model_id_label }}
    spec:
{% if fma.launcherNodeSelection is defined and fma.launcherNodeSelection.enabled | default(false) %}
      # Pin the requester to the single GPU node step_06 selected + labeled.
      # ANDed with the nodeAffinity below (which stays load-bearing for WVA).
      nodeSelector:
        {{ fma.launcherNodeSelection.nodeLabel | default('fma-hotstart') }}: "true"
{% endif %}
      {# Pick a resolved accelerator type from decode/prefill/standalone
         (cluster_resource_resolver.py rewrites `labelValue: auto` into the
         concrete value, e.g. NVIDIA-H100-80GB-HBM3, before this template
         runs). Using `operator: In` with a concrete value is required for
         WVA's resolver to extract the accelerator name from nodeAffinity;
         `operator: Exists` finds the key but returns no value, and WVA falls
         back to "unresolved" — which silences its saturation engine
         (OptimizationFailed: No saturation metrics available for model). #}
      {% set _fma_accel = (decode.acceleratorType if decode is defined and decode.acceleratorType is defined and decode.acceleratorType.labelValue is defined
                           else (prefill.acceleratorType if prefill is defined and prefill.acceleratorType is defined and prefill.acceleratorType.labelValue is defined
                                 else (standalone.acceleratorType if standalone is defined and standalone.acceleratorType is defined and standalone.acceleratorType.labelValue is defined
                                       else None))) %}
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: {{ _fma_accel.labelKey if _fma_accel else 'nvidia.com/gpu.product' }}
                    operator: In
                    values:
                      - "{{ _fma_accel.labelValue if _fma_accel else 'NVIDIA-H100-80GB-HBM3' }}"
      containers:
        - name: inference-server
          image: {{ fma.requester.image.repository }}:{{ fma.requester.image.tag }}
          imagePullPolicy: {{ fma.requester.image.pullPolicy }}
          command:
          - /app/requester
          ports:
          - name: probes
            containerPort: {{ fma.requester.probePort }}
          - name: spi
            containerPort: {{ fma.requester.spiPort }}
          readinessProbe:
            httpGet:
              path: /ready
              port: {{ fma.requester.probePort }}
            initialDelaySeconds: 2
            periodSeconds: 5
          resources:
            limits:
              nvidia.com/gpu: {{ fma.requester.limitsGPU }}
              cpu: {{ fma.requester.limitsCPU }}
              memory: {{ fma.requester.limitsMemory }}

{% endif %}
