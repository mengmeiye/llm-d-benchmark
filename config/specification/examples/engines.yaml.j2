# Engine Swap Example Specification
# One small single-role GPU stack that runs on vLLM, SGLang or TensorRT-LLM.
# vLLM is the active command; the other two are tagged `# @engine <name>` and
# selected with `--engine sglang` / `--engine trtllm`, no edit required.
# See scenarios/examples/engines.yaml for details.

# [REQUIRED]
{% set base_dir = base_dir | default('../') -%}
base_dir: {{ base_dir }}

# [REQUIRED]
values_file:
  path: {{ base_dir }}/config/templates/values/defaults.yaml

# [REQUIRED]
template_dir:
  path: {{ base_dir }}/config/templates/jinja

# [OPTIONAL]
scenario_file:
  path: {{ base_dir }}/config/scenarios/examples/engines.yaml
